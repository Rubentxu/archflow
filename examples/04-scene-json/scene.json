{
  "$schema": "https://archflow.dev/schemas/scene.json",
  "version": "1.0.0",
  "metadata": {
    "name": "Demo Scene",
    "description": "Example scene for ArchFlow JSON loading"
  },
  "config": {
    "physics": {
      "gravity": [0, -9.81, 0]
    },
    "render": {
      "backend": "webgl2"
    }
  },
  "entities": [
    {
      "id": "player",
      "components": {
        "transform": { "position": { "x": 100, "y": 200 } },
        "velocity": { "x": 0, "y": 0 },
        "render": { "shape": "rect", "color": "#4488ff", "width": 50, "height": 80 },
        "physics": { "type": "dynamic", "mass": 1.0, "friction": 0.5 }
      }
    },
    {
      "id": "ground",
      "components": {
        "transform": { "position": { "x": 400, "y": 500 }, "scale": { "x": 800, "y": 20 } },
        "render": { "shape": "rect", "color": "#444444", "width": 800, "height": 20 },
        "physics": { "type": "static" }
      }
    },
    {
      "id": "coin",
      "components": {
        "transform": { "position": { "x": 300, "y": 150 } },
        "render": { "shape": "circle", "color": "#ffd700", "radius": 15 },
        "sensor": { "type": "proximity", "distance": 30 }
      }
    }
  ]
}
